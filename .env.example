# Copy this file to .env. Never commit real API keys.
# Process environment variables take precedence over values in .env.

# --- Chat model -------------------------------------------------------------
# Allowed: groq, openai, huggingface
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Used when LLM_PROVIDER=huggingface
HF_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# --- Embeddings -------------------------------------------------------------
# Embeddings are configured independently from the chat model.
# Allowed: huggingface, openai
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DEVICE=cpu
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Generation -------------------------------------------------------------
LLM_TEMPERATURE=0.1
MAX_TOKENS=1024

# --- Vector database --------------------------------------------------------
# Allowed: chroma, faiss
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_documents
FAISS_INDEX_PATH=./faiss_index

# Keep false unless the FAISS index is trusted and was created by this app.
FAISS_ALLOW_DANGEROUS_DESERIALIZATION=false

# --- Chunking and retrieval -------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
# Minimum 0..1 similarity required before context is sent to the LLM.
# Set to -1 to disable the relevance gate.
RETRIEVAL_MIN_RELEVANCE=0.20

# --- Files and UI -----------------------------------------------------------
DOCUMENTS_DIR=./data/documents
SNIPPET_MAX_CHARS=200
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=10

# --- Optional Google Drive ingestion ---------------------------------------
# Install the optional dependencies documented in README.md before enabling.
# GOOGLE_SERVICE_ACCOUNT_KEY=/absolute/path/to/service-account-key.json
